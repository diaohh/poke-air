# ── Server (apps/server) ─────────────────────────────────────────────
# Port for Fastify + Socket.IO
PORT=3001
# Comma-separated list of allowed frontend origins (CORS). "*" is only acceptable in development.
ALLOWED_ORIGINS=http://localhost:5173
# Pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ── Web (apps/web) — must be prefixed with VITE_ ─────────────────────
# Backend URL. If empty, the web app uses <current hostname>:3001 (works on LAN in dev).
VITE_BACKEND_URL=
# Public URL encoded in the join QR. If empty, the dev LAN address is used (see docs/10-development.md).
VITE_PUBLIC_APP_URL=
